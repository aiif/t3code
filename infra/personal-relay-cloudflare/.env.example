# Local development and deployment inputs for the Cloudflare relay.
# Copy to .dev.vars for `wrangler dev` (gitignored), or let scripts/deploy.mjs
# generate the secrets file. Never commit real values.

# Relay root credential. Only /v1/admin/* accepts it. At least 32 characters.
T3CODE_ADMIN_KEY=

# 32 raw bytes as 64 hex characters or base64url. Encrypts host keys at rest.
# Losing this key breaks admin host-key reveal and forces hosts to re-register.
T3CODE_SECRET_KEY=

# Required for POST /v1/hosts/register. At least 32 characters. Never the admin key.
T3CODE_ENROLL_KEY=

# Runtime Cloudflare API token: Cloudflare Tunnel Edit + DNS Edit for the zone.
# Not needed for quick mode.
T3CODE_CF_API_TOKEN=

# auto picks named when the account, zone, suffix and token are all present.
T3CODE_TUNNEL_MODE=auto
T3CODE_CF_ACCOUNT_ID=
T3CODE_CF_ZONE_ID=
T3CODE_HOSTS_SUFFIX=
TUNNEL_PREFIX=t3cf

T3CODE_MAX_HOSTS=20
T3CODE_HEARTBEAT_INTERVAL_MS=60000
T3CODE_HEARTBEAT_TTL_MS=180000

# Extra browser origins allowed to call /v1/*. Never use "*".
T3CODE_ALLOWED_ORIGINS=
