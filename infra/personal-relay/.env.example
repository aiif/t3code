# Relay root credential. Only /v1/admin/* accepts it. The old
# /root/t3-personal-key.txt becomes this value. Never put it on a host or guest.
T3CODE_ADMIN_KEY=CHANGE_ME_openssl_rand_base64_32

# 32-byte key that encrypts host keys at rest. Generate with:
#   openssl rand -base64 32
T3CODE_SECRET_KEY=CHANGE_ME_openssl_rand_base64_32

# Portal origin served by OpenResty. Host public URLs are built as
# https://<hostId>.<hostname of this URL>.
T3CODE_PORTAL_URL=https://relay.example.com

# Extra browser origins allowed to call the API, comma-separated. The portal
# origin is always allowed.
# T3CODE_ALLOWED_ORIGINS=http://localhost:5173

# Public VPS address hosts dial for frp. Must match the certificate's domain
# only through the wildcard vhost, not through frp itself.
FRP_SERVER_ADDR=CHANGE_ME_VPS_PUBLIC_ADDRESS
FRP_SERVER_PORT=7001
# Must equal auth.token in frps.toml.
FRP_AUTH_TOKEN=CHANGE_ME_FRP_AUTH_TOKEN

# Web Push VAPID subject may be the portal URL.
VAPID_SUBJECT=https://relay.example.com
